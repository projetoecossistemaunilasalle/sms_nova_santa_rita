generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  ARCHIVED @map("archived")

  @@map("record_status")
}

enum PlatformRole {
  PLATFORM_ADMIN @map("platform_admin")

  @@map("platform_role")
}

enum OrganizationRole {
  ORGANIZATION_ADMIN @map("organization_admin")
  TEACHER            @map("teacher")

  @@map("organization_role")
}

enum PlayerCredentialStatus {
  ACTIVE  @map("active")
  REVOKED @map("revoked")

  @@map("player_credential_status")
}

enum GameSessionStatus {
  ACTIVE @map("active")
  ENDED  @map("ended")

  @@map("game_session_status")
}

model ProfessionalProfile {
  id           String                   @id @default(uuid()) @db.Uuid
  authUserId   String                   @unique @map("auth_user_id") @db.VarChar(255)
  displayName  String                   @map("display_name") @db.VarChar(160)
  platformRole PlatformRole?            @map("platform_role")
  status       RecordStatus             @default(ACTIVE)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships  OrganizationMembership[]

  @@map("professional_profiles")
}

model Organization {
  id          String                   @id @default(uuid()) @db.Uuid
  name        String                   @db.VarChar(200)
  type        String                   @db.VarChar(80)
  status      RecordStatus             @default(ACTIVE)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships OrganizationMembership[]
  classGroups ClassGroup[]

  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id                    String              @id @default(uuid()) @db.Uuid
  professionalProfileId String              @map("professional_profile_id") @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  role                  OrganizationRole
  status                RecordStatus        @default(ACTIVE)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  professionalProfile   ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teacherAssignments    TeacherAssignment[]

  @@unique([professionalProfileId, organizationId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model ClassGroup {
  id                      String              @id @default(uuid()) @db.Uuid
  organizationId          String              @map("organization_id") @db.Uuid
  name                    String              @db.VarChar(160)
  status                  RecordStatus        @default(ACTIVE)
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teacherAssignments      TeacherAssignment[]
  nextPlayerNumber        Int                 @default(1) @map("next_player_number")
  playerSlots             PlayerSlot[]
  gameSessions            GameSession[]
  defaultContentSelection Json?               @map("default_content_selection") @db.JsonB

  @@index([organizationId, status])
  @@map("class_groups")
}

model PlayerSlot {
  id             String             @id @default(uuid()) @db.Uuid
  classGroupId   String             @map("class_group_id") @db.Uuid
  playerNumber   Int                @map("player_number")
  status         RecordStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  classGroup     ClassGroup         @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  credentials    PlayerCredential[]
  participations Participation[]
  gameState      GameState?

  @@unique([classGroupId, playerNumber])
  @@index([classGroupId, status])
  @@map("player_slots")
}

model PlayerCredential {
  id             String                 @id @default(uuid()) @db.Uuid
  playerSlotId   String                 @map("player_slot_id") @db.Uuid
  tokenHash      String                 @unique @map("token_hash") @db.Char(64)
  encryptedToken String?                @map("encrypted_token") @db.Text
  status         PlayerCredentialStatus @default(ACTIVE)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt      DateTime?              @map("revoked_at") @db.Timestamptz(3)
  playerSlot     PlayerSlot             @relation(fields: [playerSlotId], references: [id], onDelete: Restrict)

  @@index([playerSlotId, status])
  @@map("player_credentials")
}

// Payload and import metadata are immutable; only isCurrent may change.
// migration.sql enforces one current row with a partial unique index on is_current.
model GameContentManifest {
  id             String        @id @default(uuid()) @db.Uuid
  contentVersion String        @map("content_version") @db.VarChar(200)
  buildId        String        @unique @map("build_id") @db.VarChar(100)
  // release.json is optional; never invent provenance when it is absent.
  sourceCommit   String?       @map("source_commit") @db.VarChar(64)
  manifestHash   String        @map("manifest_hash") @db.Char(64)
  payload        Json          @db.JsonB
  importedAt     DateTime      @default(now()) @map("imported_at") @db.Timestamptz(3)
  importedById   String?       @map("imported_by_id") @db.Uuid
  isCurrent      Boolean       @default(false) @map("is_current")
  gameSessions   GameSession[]

  @@index([contentVersion])
  @@map("game_content_manifests")
}

model GameSession {
  id                String               @id @default(uuid()) @db.Uuid
  classGroupId      String               @map("class_group_id") @db.Uuid
  status            GameSessionStatus    @default(ACTIVE)
  startedAt         DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt           DateTime?            @map("ended_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  classGroup        ClassGroup           @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  participations    Participation[]
  contentManifestId String               @map("content_manifest_id") @db.Uuid
  contentPolicy     Json                 @map("content_policy") @db.JsonB
  startedById       String?              @map("started_by_id") @db.Uuid
  contentManifest   GameContentManifest  @relation(fields: [contentManifestId], references: [id], onDelete: Restrict)

  @@index([classGroupId, status])
  @@index([contentManifestId])
  @@map("game_sessions")
}

model Participation {
  id               String            @id @default(uuid()) @db.Uuid
  gameSessionId    String            @map("game_session_id") @db.Uuid
  playerSlotId     String            @map("player_slot_id") @db.Uuid
  joinedAt         DateTime          @default(now()) @map("joined_at") @db.Timestamptz(3)
  gameSession      GameSession       @relation(fields: [gameSessionId], references: [id], onDelete: Restrict)
  playerSlot       PlayerSlot        @relation(fields: [playerSlotId], references: [id], onDelete: Restrict)
  resultEvents     ResultEvent[]
  activeTimeEvents ActiveTimeEvent[]

  @@unique([gameSessionId, playerSlotId])
  @@index([playerSlotId, joinedAt])
  @@map("participations")
}

model GameState {
  playerSlotId    String     @id @map("player_slot_id") @db.Uuid
  protocolVersion Int        @map("protocol_version")
  schemaVersion   Int        @map("schema_version")
  contentVersion  String     @map("content_version") @db.VarChar(200)
  payload         Json       @db.JsonB
  revision        Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  playerSlot      PlayerSlot @relation(fields: [playerSlotId], references: [id], onDelete: Restrict)

  @@map("game_states")
}

model ResultEvent {
  id              String        @id @default(uuid()) @db.Uuid
  participationId String        @map("participation_id") @db.Uuid
  clientEventId   String        @unique @map("client_event_id") @db.VarChar(200)
  requestId       String        @map("request_id") @db.VarChar(200)
  activityId      String        @map("activity_id") @db.VarChar(100)
  missionId       String        @map("mission_id") @db.VarChar(100)
  moduleId        String?       @map("module_id") @db.VarChar(64)
  presetId        String?       @map("preset_id") @db.VarChar(64)
  attemptId       String        @map("attempt_id") @db.VarChar(200)
  resultState     String        @map("result_state") @db.VarChar(32)
  durationMs      BigInt        @map("duration_ms")
  metrics         Json          @db.JsonB
  payload         Json          @db.JsonB
  receivedAt      DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  participation   Participation @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@index([participationId, receivedAt])
  @@index([activityId, receivedAt])
  @@index([moduleId, receivedAt])
  @@map("result_events")
}

model ActiveTimeEvent {
  id              String        @id @default(uuid()) @db.Uuid
  participationId String        @map("participation_id") @db.Uuid
  clientEventId   String        @unique @map("client_event_id") @db.VarChar(200)
  requestId       String        @map("request_id") @db.VarChar(200)
  activeMs        Int           @map("active_ms")
  mode            String        @db.VarChar(20)
  missionId       String?       @map("mission_id") @db.VarChar(100)
  moduleId        String?       @map("module_id") @db.VarChar(64)
  receivedAt      DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)
  participation   Participation @relation(fields: [participationId], references: [id], onDelete: Restrict)

  @@index([participationId, receivedAt])
  @@map("active_time_events")
}

model RequestRateLimit {
  key         String   @id @db.Char(64)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("request_rate_limits")
}

model TeacherAssignment {
  id           String                 @id @default(uuid()) @db.Uuid
  membershipId String                 @map("membership_id") @db.Uuid
  classGroupId String                 @map("class_group_id") @db.Uuid
  status       RecordStatus           @default(ACTIVE)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  classGroup   ClassGroup             @relation(fields: [classGroupId], references: [id], onDelete: Restrict)

  @@unique([membershipId, classGroupId])
  @@index([classGroupId, status])
  @@map("teacher_assignments")
}
