{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "game.bootstrap_applied.v2"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "effective_mission_ids": {
      "$ref": "#/$defs/__schema0",
      "uniqueItems": true
    },
    "ignored": {
      "type": "object",
      "properties": {
        "mission_ids": {
          "$ref": "#/$defs/__schema0",
          "uniqueItems": true
        },
        "presets": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mission_ids",
        "presets",
        "options"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "request_id",
    "effective_mission_ids",
    "ignored"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}
