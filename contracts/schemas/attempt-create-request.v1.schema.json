{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missoes.example/schemas/attempt-create-request.v1.schema.json",
  "title": "Create attempt request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "game_key"],
  "properties": {
    "schema_version": { "const": 1 },
    "game_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,99}$" }
  }
}
