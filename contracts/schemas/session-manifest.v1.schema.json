{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missoes.example/schemas/session-manifest.v1.schema.json",
  "title": "Session manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "play_session_id", "activity", "module", "games", "expires_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "play_session_id": { "$ref": "#/$defs/id" },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/positiveInteger" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "version"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "version": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "games": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["game_key", "runtime_key", "runtime_version", "position", "required", "parameters"],
        "properties": {
          "game_key": { "$ref": "#/$defs/key" },
          "runtime_key": { "$ref": "#/$defs/key" },
          "runtime_version": { "$ref": "#/$defs/positiveInteger" },
          "position": { "$ref": "#/$defs/positiveInteger" },
          "required": { "type": "boolean" },
          "parameters": { "type": "object" }
        }
      }
    },
    "expires_at": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,99}$" },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
