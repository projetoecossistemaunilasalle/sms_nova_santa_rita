{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missoes.example/schemas/games/defesa-bolas-config.v1.schema.json",
  "title": "Defesa de bolas configuration V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dificuldade", "velocidade_bola", "quantidade_bolas", "trocas_para_concluir"],
  "properties": {
    "dificuldade": { "type": "integer", "minimum": 1, "maximum": 3 },
    "velocidade_bola": { "type": "integer", "minimum": 100, "maximum": 800 },
    "quantidade_bolas": { "type": "integer", "minimum": 1, "maximum": 12 },
    "trocas_para_concluir": { "type": "integer", "minimum": 1, "maximum": 100 }
  }
}
