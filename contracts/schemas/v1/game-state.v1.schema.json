{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "#/$defs/__schema0"
    },
    "content_version": {
      "$ref": "#/$defs/__schema1"
    },
    "missions": {
      "$ref": "#/$defs/__schema2"
    },
    "progression": {
      "$ref": "#/$defs/__schema6"
    }
  },
  "required": [
    "schema_version",
    "content_version",
    "missions",
    "progression"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "number",
      "const": 1
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "when_play_stops_being_play": {
          "$ref": "#/$defs/__schema3"
        },
        "lia_memory": {
          "$ref": "#/$defs/__schema3"
        },
        "pingpong_soccer": {
          "$ref": "#/$defs/__schema3"
        },
        "respect_also_cares": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "when_play_stops_being_play",
        "lia_memory",
        "pingpong_soccer",
        "respect_also_cares"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "active",
            "complete"
          ]
        },
        "stage_id": {
          "$ref": "#/$defs/__schema1"
        },
        "checkpoints": {
          "$ref": "#/$defs/__schema4"
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema5"
          }
        }
      },
      "required": [
        "status",
        "stage_id",
        "checkpoints",
        "data"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "boolean",
        "const": true
      }
    },
    "__schema5": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "maxItems": 256,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema5"
          }
        }
      ]
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "coins": {
          "$ref": "#/$defs/__schema7"
        },
        "stars": {
          "$ref": "#/$defs/__schema7"
        },
        "challenges": {
          "$ref": "#/$defs/__schema4"
        },
        "rewards": {
          "$ref": "#/$defs/__schema4"
        }
      },
      "required": [
        "coins",
        "stars",
        "challenges",
        "rewards"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "type": "number",
      "minimum": 0
    }
  },
  "$id": "https://missoes.example/schemas/v1/game-state.v1.schema.json",
  "title": "game-state V1",
  "x-state-max-serialized-utf8-bytes": 65536
}
