{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missoes.example/schemas/attempt-result-request.v1.schema.json",
  "title": "Attempt result request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "client_event_id", "attempt_id", "result"],
  "properties": {
    "schema_version": { "const": 1 },
    "client_event_id": { "type": "string", "format": "uuid" },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estado", "duracao_ms", "metricas"],
      "properties": {
        "estado": { "enum": ["sucesso", "falha", "abandonado"] },
        "duracao_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
        "metricas": { "type": "object" }
      }
    }
  }
}
