{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "$ref": "#/$defs/__schema0"
    },
    "events": {
      "$ref": "#/$defs/__schema1",
      "x-uniqueBy": [
        "request_id"
      ]
    }
  },
  "required": [
    "type",
    "events"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "game.active_time.v2"
    },
    "__schema1": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "#/$defs/__schema3"
        },
        "active_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "mode": {
          "type": "string",
          "enum": [
            "exploration",
            "dialogue",
            "activity"
          ]
        },
        "mission_id": {
          "$ref": "#/$defs/__schema3"
        }
      },
      "required": [
        "request_id",
        "active_ms",
        "mode"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
