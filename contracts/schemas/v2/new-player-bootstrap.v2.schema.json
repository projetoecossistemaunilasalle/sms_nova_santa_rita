{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "portal.bootstrap.v2"
    },
    "request_id": {
      "$ref": "#/$defs/__schema0"
    },
    "protocol_version": {
      "type": "number",
      "const": 2
    },
    "player_id": {
      "$ref": "#/$defs/__schema0"
    },
    "class_session_id": {
      "$ref": "#/$defs/__schema0"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "content_policy": {
      "type": "object",
      "properties": {
        "policy_version": {
          "type": "number",
          "const": 1
        },
        "authored_content_version": {
          "$ref": "#/$defs/__schema0"
        },
        "enabled_module_ids": {
          "$ref": "#/$defs/__schema1",
          "uniqueItems": true
        },
        "enabled_mission_ids": {
          "$ref": "#/$defs/__schema1",
          "uniqueItems": true
        },
        "activity_presets": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "policy_version",
        "authored_content_version",
        "enabled_module_ids",
        "enabled_mission_ids"
      ],
      "additionalProperties": false
    },
    "new_player": {
      "type": "boolean",
      "const": true
    },
    "state": {
      "type": "null"
    },
    "stored_content_version": {
      "type": "null"
    }
  },
  "required": [
    "type",
    "request_id",
    "protocol_version",
    "player_id",
    "class_session_id",
    "revision",
    "content_policy",
    "new_player",
    "state",
    "stored_content_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema1": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  }
}
