{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "$ref": "#/$defs/__schema0"
    },
    "acknowledged_event_ids": {
      "$ref": "#/$defs/__schema1",
      "uniqueItems": true
    }
  },
  "required": [
    "type",
    "acknowledged_event_ids"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "portal.active_time_ack.v2"
    },
    "__schema1": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
