{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/__schema0"
        },
        "request_id": {
          "$ref": "#/$defs/__schema1"
        },
        "protocol_version": {
          "$ref": "#/$defs/__schema2"
        },
        "player_id": {
          "$ref": "#/$defs/__schema1"
        },
        "class_session_id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema3"
        },
        "content_policy": {
          "$ref": "#/$defs/__schema4"
        },
        "new_player": {
          "type": "boolean",
          "const": false
        },
        "state": {
          "$ref": "#/$defs/__schema7"
        },
        "stored_content_version": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "type",
        "request_id",
        "protocol_version",
        "player_id",
        "class_session_id",
        "revision",
        "content_policy",
        "new_player",
        "state",
        "stored_content_version"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/__schema0"
        },
        "request_id": {
          "$ref": "#/$defs/__schema1"
        },
        "protocol_version": {
          "$ref": "#/$defs/__schema2"
        },
        "player_id": {
          "$ref": "#/$defs/__schema1"
        },
        "class_session_id": {
          "$ref": "#/$defs/__schema1"
        },
        "revision": {
          "$ref": "#/$defs/__schema3"
        },
        "content_policy": {
          "$ref": "#/$defs/__schema4"
        },
        "new_player": {
          "type": "boolean",
          "const": true
        },
        "state": {
          "type": "null"
        },
        "stored_content_version": {
          "type": "null"
        }
      },
      "required": [
        "type",
        "request_id",
        "protocol_version",
        "player_id",
        "class_session_id",
        "revision",
        "content_policy",
        "new_player",
        "state",
        "stored_content_version"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "__schema0": {
      "type": "string",
      "const": "portal.bootstrap.v2"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "__schema2": {
      "type": "number",
      "const": 2
    },
    "__schema3": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "policy_version": {
          "type": "number",
          "const": 1
        },
        "authored_content_version": {
          "$ref": "#/$defs/__schema1"
        },
        "enabled_module_ids": {
          "$ref": "#/$defs/__schema5",
          "uniqueItems": true
        },
        "enabled_mission_ids": {
          "$ref": "#/$defs/__schema5",
          "uniqueItems": true
        },
        "activity_presets": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "anyOf": [
            {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "policy_version",
        "authored_content_version",
        "enabled_module_ids",
        "enabled_mission_ids"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema6"
      }
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 3
        }
      },
      "required": [
        "schema_version"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/__schema8"
      },
      "x-state-max-serialized-utf8-bytes": 262144,
      "x-state-max-depth": 32
    },
    "__schema8": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema8"
          }
        }
      ]
    }
  }
}
