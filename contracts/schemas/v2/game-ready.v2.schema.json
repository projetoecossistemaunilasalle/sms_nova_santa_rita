{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "game.ready.v2"
    },
    "supported_protocol_versions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "supported_state_schema_versions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "content_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "type",
    "supported_protocol_versions",
    "supported_state_schema_versions",
    "content_version"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  }
}
