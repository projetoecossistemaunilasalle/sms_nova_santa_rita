{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missoes.example/schemas/attempt-result-ack.v1.schema.json",
  "title": "Attempt result acknowledgement V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt_id", "client_event_id", "accepted_at", "duplicate"],
  "properties": {
    "schema_version": { "const": 1 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "client_event_id": { "type": "string", "format": "uuid" },
    "accepted_at": { "type": "string", "format": "date-time" },
    "duplicate": { "type": "boolean" }
  }
}
