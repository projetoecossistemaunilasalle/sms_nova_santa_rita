{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missoes.example/schemas/api-error.v1.schema.json",
  "title": "Portal API error V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "correlation_id"],
      "properties": {
        "code": {
          "enum": [
            "AUTHENTICATION_REQUIRED",
            "FORBIDDEN",
            "RESOURCE_NOT_FOUND",
            "VALIDATION_FAILED",
            "CONFLICT",
            "RATE_LIMITED",
            "SERVICE_UNAVAILABLE",
            "INTERNAL_SERVER_ERROR",
            "ACTIVITY_NOT_OPEN",
            "ACTIVITY_LINK_INVALID",
            "ACTIVITY_LINK_EXPIRED",
            "MODULE_LAUNCHES_BLOCKED",
            "GAME_NOT_IN_ACTIVITY",
            "GAME_DISABLED_FOR_ACTIVITY",
            "GAME_LAUNCHES_BLOCKED",
            "ATTEMPT_ALREADY_COMPLETED",
            "RESULT_SCHEMA_INVALID",
            "SCHEMA_VERSION_UNSUPPORTED",
            "SESSION_EXPIRED"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "correlation_id": { "type": "string", "format": "uuid" },
        "details": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": { "type": "string", "maxLength": 500 },
              "reason": { "type": "string", "maxLength": 500 }
            }
          }
        }
      }
    }
  }
}
