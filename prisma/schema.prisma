generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  ARCHIVED @map("archived")

  @@map("record_status")
}

enum Capability {
  LINK_VIEW                 @map("link:view")
  LINK_MANAGE               @map("link:manage")
  RESULTS_VIEW_ORGANIZATION @map("results:view_organization")
  ORGANIZATION_MANAGE       @map("organization:manage")
  USER_MANAGE               @map("user:manage")
  AUDIT_VIEW                @map("audit:view")

  @@map("capability")
}

enum PlatformRole {
  PLATFORM_ADMIN @map("platform_admin")

  @@map("platform_role")
}

enum OrganizationRole {
  ORGANIZATION_ADMIN @map("organization_admin")
  TEACHER            @map("teacher")

  @@map("organization_role")
}

enum PlayerCredentialStatus {
  ACTIVE  @map("active")
  REVOKED @map("revoked")

  @@map("player_credential_status")
}

enum GameSessionStatus {
  ACTIVE @map("active")
  ENDED  @map("ended")

  @@map("game_session_status")
}

model ProfessionalProfile {
  id                 String                   @id @default(uuid()) @db.Uuid
  authUserId         String                   @unique @map("auth_user_id") @db.VarChar(255)
  displayName        String                   @map("display_name") @db.VarChar(160)
  platformRole       PlatformRole?            @map("platform_role")
  status             RecordStatus             @default(ACTIVE)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        OrganizationMembership[]
  createdAccessLinks AccessLink[]             @relation("AccessLinkCreator")
  auditEvents        AuditEvent[]             @relation("AuditActor")

  @@map("professional_profiles")
}

model Organization {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String                   @db.VarChar(200)
  type               String                   @db.VarChar(80)
  status             RecordStatus             @default(ACTIVE)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        OrganizationMembership[]
  scopedCapabilities CapabilityAssignment[]   @relation("CapabilityScope")
  accessLinks        AccessLink[]
  classGroups        ClassGroup[]

  @@index([status])
  @@map("organizations")
}

model OrganizationMembership {
  id                    String                 @id @default(uuid()) @db.Uuid
  professionalProfileId String                 @map("professional_profile_id") @db.Uuid
  organizationId        String                 @map("organization_id") @db.Uuid
  role                  OrganizationRole
  status                RecordStatus           @default(ACTIVE)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  professionalProfile   ProfessionalProfile    @relation(fields: [professionalProfileId], references: [id], onDelete: Restrict)
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  capabilityAssignments CapabilityAssignment[]
  teacherAssignments    TeacherAssignment[]

  @@unique([professionalProfileId, organizationId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model ClassGroup {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  name               String              @db.VarChar(160)
  status             RecordStatus        @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teacherAssignments TeacherAssignment[]
  nextPlayerNumber   Int                 @default(1) @map("next_player_number")
  playerSlots        PlayerSlot[]
  gameSessions       GameSession[]

  @@index([organizationId, status])
  @@map("class_groups")
}

model PlayerSlot {
  id             String             @id @default(uuid()) @db.Uuid
  classGroupId   String             @map("class_group_id") @db.Uuid
  playerNumber   Int                @map("player_number")
  status         RecordStatus       @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  classGroup     ClassGroup         @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  credentials    PlayerCredential[]
  participations Participation[]

  @@unique([classGroupId, playerNumber])
  @@index([classGroupId, status])
  @@map("player_slots")
}

model PlayerCredential {
  id           String                 @id @default(uuid()) @db.Uuid
  playerSlotId String                 @map("player_slot_id") @db.Uuid
  tokenHash    String                 @unique @map("token_hash") @db.Char(64)
  status       PlayerCredentialStatus @default(ACTIVE)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt    DateTime?              @map("revoked_at") @db.Timestamptz(3)
  playerSlot   PlayerSlot             @relation(fields: [playerSlotId], references: [id], onDelete: Restrict)

  @@index([playerSlotId, status])
  @@map("player_credentials")
}

model GameSession {
  id             String            @id @default(uuid()) @db.Uuid
  classGroupId   String            @map("class_group_id") @db.Uuid
  status         GameSessionStatus @default(ACTIVE)
  startedAt      DateTime          @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime?         @map("ended_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  classGroup     ClassGroup        @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  participations Participation[]

  @@index([classGroupId, status])
  @@map("game_sessions")
}

model Participation {
  id            String      @id @default(uuid()) @db.Uuid
  gameSessionId String      @map("game_session_id") @db.Uuid
  playerSlotId  String      @map("player_slot_id") @db.Uuid
  joinedAt      DateTime    @default(now()) @map("joined_at") @db.Timestamptz(3)
  gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Restrict)
  playerSlot    PlayerSlot  @relation(fields: [playerSlotId], references: [id], onDelete: Restrict)

  @@unique([gameSessionId, playerSlotId])
  @@index([playerSlotId, joinedAt])
  @@map("participations")
}

model TeacherAssignment {
  id           String                 @id @default(uuid()) @db.Uuid
  membershipId String                 @map("membership_id") @db.Uuid
  classGroupId String                 @map("class_group_id") @db.Uuid
  status       RecordStatus           @default(ACTIVE)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership   OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  classGroup   ClassGroup             @relation(fields: [classGroupId], references: [id], onDelete: Restrict)

  @@unique([membershipId, classGroupId])
  @@index([classGroupId, status])
  @@map("teacher_assignments")
}

model CapabilityAssignment {
  id                  String                 @id @default(uuid()) @db.Uuid
  membershipId        String                 @map("membership_id") @db.Uuid
  capability          Capability
  scopeOrganizationId String?                @map("scope_organization_id") @db.Uuid
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  membership          OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  scopeOrganization   Organization?          @relation("CapabilityScope", fields: [scopeOrganizationId], references: [id], onDelete: Restrict)

  // Uniqueness of (membershipId, capability, scopeOrganizationId) with NULLS NOT
  // DISTINCT semantics for the nullable scope is enforced by a raw unique index
  // in migrations/0_init/migration.sql; Prisma cannot express it.
  @@index([scopeOrganizationId, capability])
  @@map("capability_assignments")
}

model AccessLink {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  createdById    String              @map("created_by_id") @db.Uuid
  label          String              @db.VarChar(200)
  audience       String              @db.VarChar(200)
  tokenHash      String              @unique @map("token_hash") @db.Char(64)
  expiresAt      DateTime?           @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?           @map("revoked_at") @db.Timestamptz(3)
  pausedAt       DateTime?           @map("paused_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy      ProfessionalProfile @relation("AccessLinkCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, revokedAt])
  @@index([expiresAt])
  @@map("access_links")
}

model AuditEvent {
  id            String               @id @default(uuid()) @db.Uuid
  actorId       String?              @map("actor_id") @db.Uuid
  action        String               @db.VarChar(120)
  entityType    String               @map("entity_type") @db.VarChar(80)
  entityId      String               @map("entity_id") @db.Uuid
  before        Json?                @db.JsonB
  after         Json?                @db.JsonB
  reason        String?              @db.VarChar(500)
  correlationId String               @map("correlation_id") @db.VarChar(64)
  occurredAt    DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actor         ProfessionalProfile? @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([occurredAt])
  @@map("audit_events")
}

model RateLimitBucket {
  bucketKey       String   @id @map("bucket_key") @db.Char(64)
  scope           String   @db.VarChar(80)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  requestCount    Int      @default(0) @map("request_count")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
