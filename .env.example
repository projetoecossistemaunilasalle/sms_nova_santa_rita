# Explicit runtime composition. Build scripts set this automatically; use
# `server` for real infrastructure and `demo` for the local server-side mock.
APP_RUNTIME_MODE=server

# Base URL for the existing GameMaker client that receives activity handoffs.
GAME_CLIENT_URL=https://game.example.com

# Pooled Neon connection used by the running application.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/database?sslmode=require

# Direct Neon connection used only by Prisma CLI and deployment migrations.
DIRECT_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/database?sslmode=require

# Neon Auth branch endpoint and local cookie-signing secret used by the
# official @neondatabase/auth Next.js server adapter.
NEON_AUTH_BASE_URL=https://ep-example.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Comma-separated browser origins accepted by cookie-authenticated routes.
ALLOWED_ORIGINS=http://localhost:3000

# Signs player launches and privacy-preserving rate-limit keys. Existing V1
# credential ciphertext also used this secret; retain it in the key ring before rotating.
APPLICATION_SECRET=replace-with-at-least-32-random-characters

# Credential encryption uses immutable key IDs. The default key falls back to
# APPLICATION_SECRET for compatibility. Supply JSON historical/current secrets
# before rotating, then select a new key ID. Never change a secret under an existing ID.
PLAYER_CREDENTIAL_KEY_ID=default
PLAYER_CREDENTIAL_KEYS={}

# Original participations may flush offline records for 24 hours after session end.
OFFLINE_FLUSH_WINDOW_SECONDS=86400

# Optional: set only when a trusted reverse proxy STRIPS and OVERRIDES this header
# and direct access to the application is blocked. Otherwise forwarded IPs are ignored.
# RATE_LIMIT_CLIENT_IP_HEADER=x-real-ip

LOG_LEVEL=info
READINESS_TIMEOUT_MS=2000

# Local development only: browse the professional portal without signing in.
# Validation rejects this in demo mode and in a production server runtime.
AUTH_DEV_BYPASS=false
