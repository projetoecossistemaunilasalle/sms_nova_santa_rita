{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@runtime/sign-in-action": ["./src/app/(professional)/entrar/actions.ts"],
      "@runtime/sign-out-action": [
        "./src/app/(professional)/portal/sign-out-action.ts"
      ],
      "@runtime/adult-portal": ["./src/runtime/adult-portal-server.ts"],
      "@runtime/adult-portal-actions": [
        "./src/app/(professional)/portal/adult-portal-actions.ts"
      ],
      "@runtime/adult-portal-client": [
        "./src/runtime/adult-portal-server-client.ts"
      ],
      "@runtime/player-access-actions": [
        "./src/app/(professional)/portal/player-access-actions.ts"
      ],
      "@runtime/player-entry-action": [
        "./src/app/(public-play)/jogar/actions.ts"
      ],
      "@runtime/player-access": ["./src/runtime/player-access-server.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
