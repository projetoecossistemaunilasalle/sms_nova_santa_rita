{
  "name": "missoes-caramelito-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.19.0",
    "npm": ">=11.6.0 <12"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "node scripts/next-target.mjs dev server",
    "dev:demo": "node scripts/next-target.mjs dev demo",
    "build": "npm run build:server",
    "build:demo": "node scripts/next-target.mjs build demo",
    "build:server": "node scripts/next-target.mjs build server",
    "start": "node scripts/start.mjs",
    "clean:build": "node scripts/clean-build-artifacts.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:server": "node scripts/next-target.mjs gen server && tsc --noEmit --incremental false",
    "typecheck:demo": "node scripts/next-target.mjs gen demo && tsc --noEmit --incremental false",
    "typecheck": "npm run typecheck:server && npm run typecheck:demo",
    "test": "node scripts/next-target.mjs gen demo && vitest run",
    "test:contracts": "vitest run tests/unit/v1-contracts.test.ts",
    "test:watch": "node scripts/next-target.mjs gen demo && vitest",
    "check": "npm run format:check && npm run lint && npm run prisma:validate && npm run prisma:generate && npm run typecheck && npm test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "1.1.0",
    "@next/env": "16.3.6",
    "@prisma/adapter-neon": "7.9.1",
    "@prisma/client": "7.9.1",
    "@types/qrcode": "^1.5.6",
    "next": "16.3.6",
    "pino": "10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "ajv": "^8.17.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "^6.2.5",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
