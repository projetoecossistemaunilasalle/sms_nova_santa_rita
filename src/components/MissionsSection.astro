---
import { MISSOES, TOTAL_MINIGAMES } from "../config/site";
import Icon from "./Icon.astro";
---

<!--
  Secao de missoes: os cards tem fundo opaco e z-index acima do mascote,
  criando o "tunel" por onde ele passa por tras durante a rolagem.
-->
<section class="secao missoes" id="missoes" aria-labelledby="titulo-missoes">
  <div class="container">
    <div class="cabecalho-secao centrado">
      <h2 class="titulo-secao" id="titulo-missoes">{MISSOES.length} missões pela escola</h2>
      <p class="subtitulo-secao">
        Histórias sobre cuidar do corpo, das emoções e das amizades. Explore a escola, converse com
        os colegas e descubra {TOTAL_MINIGAMES} minigames, além de uma missão de escuta e reflexão sobre
        bullying.
      </p>
    </div>

    <ul class="grade-missoes">
      {
        MISSOES.map((m) => (
          <li class={`missao cor-${m.cor}`} data-mission-id={m.id}>
            <div class="missao-cabecalho">
              <span class="missao-icone">
                <Icon name={m.icone} size={30} />
              </span>
              <span class="missao-lugar">{m.lugar}</span>
            </div>
            <h3>{m.titulo}</h3>
            <p>{m.texto}</p>
            <span class="missao-atividade">{m.atividade}</span>
          </li>
        ))
      }
    </ul>
    <p class="missoes-nota">
      <Icon name="patinha" size={20} />
      <span
        ><strong>E muito mais.</strong> Novas missões e conteúdos estão sendo preparados com carinho.</span
      >
    </p>
  </div>
</section>

<style>
  .missoes {
    background: linear-gradient(180deg, var(--grama) 0%, #f6faef 100%);
    border-block: 1px solid var(--linha);
  }

  .grade-missoes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    list-style: none;
    padding: 0;
  }

  .missao {
    display: flex;
    flex-direction: column;
    background: var(--nuvem);
    border: 1.5px solid var(--linha);
    border-radius: 16px;
    padding: 1.5rem;
  }

  .missao h3 {
    font-size: 1.25rem;
    margin-top: 0.85rem;
  }

  .missao p {
    margin-top: 0.4rem;
    font-size: 1rem;
    color: var(--tinta-suave);
  }

  .missao-icone {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.3rem;
    height: 3.3rem;
    border-radius: 50%;
  }

  .missao-lugar {
    display: inline-block;
    vertical-align: middle;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  .missao-cabecalho {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .missao-atividade {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--verde-escuro);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .cor-verde .missao-icone {
    background: var(--missao-verde-bg);
    color: var(--missao-verde-fg);
  }
  .cor-azul .missao-icone {
    background: var(--missao-azul-bg);
    color: var(--missao-azul-fg);
  }
  .cor-roxo .missao-icone {
    background: var(--missao-roxo-bg);
    color: var(--missao-roxo-fg);
  }
  .cor-amarelo .missao-icone {
    background: var(--missao-amarelo-bg);
    color: var(--missao-amarelo-fg);
  }
  .cor-coral .missao-icone {
    background: var(--missao-coral-bg);
    color: var(--missao-coral-fg);
  }
  .cor-agua .missao-icone {
    background: var(--missao-agua-bg);
    color: var(--missao-agua-fg);
  }
  .cor-laranja .missao-icone {
    background: var(--missao-laranja-bg);
    color: var(--missao-laranja-fg);
  }

  .missoes-nota {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.75rem;
    color: var(--tinta-suave);
    font-size: 0.95rem;
  }
  .missoes-nota svg {
    flex: none;
    color: var(--laranja-escuro);
  }

  @media (max-width: 60rem) {
    .grade-missoes {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 38rem) {
    .grade-missoes {
      grid-template-columns: 1fr;
    }
  }
</style>
